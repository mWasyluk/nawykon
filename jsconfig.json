{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@components/*": [
                "src/components/*"
            ],
            "@constants/*": [
                "src/constants/*"
            ],
            "@contexts/*": [
                "src/contexts/*"
            ],
            "@models/*": [
                "src/models/*"
            ],
            "@screens/*": [
                "src/screens/*"
            ],
            "@services/*": [
                "src/services/*"
            ],
            "@styles": [
                "src/styles"
            ],
            "@utils/*": [
                "src/utils/*"
            ],
            "@assets/*": [
                "assets/*"
            ],
        },
    },
}
