{
  "expo": {
    "name": "nawykon",
    "slug": "nawykon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F3F3"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#F3F3F3"
      },
      "splash": {
        "image": "./assets/images/logo.png",
        "backgroundColor": "#F3F3F3"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "use": "expo",
      "buildConfig": {
        "metroTransformer": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
